<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TarangFX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/crimson</item>
    </style>

    <!-- Android 12+ SplashScreen API (backported by core-splashscreen down to API 26). -->
    <style name="Theme.TarangFX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.TarangFX</item>
    </style>
</resources>
